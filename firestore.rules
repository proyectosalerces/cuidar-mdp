rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the authenticated user is an admin
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'proyectos@residencialosalerces.com';
    }

    // ── Residencias ──────────────────────────────────────────────────
    match /residencias/{residenciaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Profesionales ────────────────────────────────────────────────
    match /profesionales/{profesionalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Reseñas ──────────────────────────────────────────────────────
    match /resenas/{resenaId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── Blog ────────────────────────────────────────────────────────
    match /blog/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Contactos ───────────────────────────────────────────────────
    match /contactos/{contactoId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Consultas ───────────────────────────────────────────────────
    match /consultas/{consultaId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Admins ───────────────────────────────────────────────────────
    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
