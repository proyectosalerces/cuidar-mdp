rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Reseñas ──────────────────────────────────────────────────────
    match /resenas/{resenaId} {
      // Anyone can read approved reviews
      allow read: if resource.data.aprobada == true;

      // Authenticated users can read their own reviews (approved or not)
      allow read: if request.auth != null
                  && resource.data.autorId == request.auth.uid;

      // Authenticated users can create reviews
      allow create: if request.auth != null
                    && request.resource.data.autorId == request.auth.uid
                    && request.resource.data.aprobada == false
                    && request.resource.data.calificacion >= 1
                    && request.resource.data.calificacion <= 5
                    && request.resource.data.titulo.size() > 0
                    && request.resource.data.comentario.size() > 0;

      // Only admins can update (approve/reject) — handled via Firebase Admin SDK
      allow update: if false;

      // Only admins can delete — handled via Firebase Admin SDK
      allow delete: if false;
    }

    // Block all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
