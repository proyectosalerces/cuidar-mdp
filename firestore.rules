rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: an authenticated user is admin iff a document with their email
    // as id exists in the `admins` collection (data-driven, no hardcoded email).
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // ── Residencias ──────────────────────────────────────────────────
    match /residencias/{residenciaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Profesionales ────────────────────────────────────────────────
    match /profesionales/{profesionalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Reseñas ──────────────────────────────────────────────────────
    match /resenas/{resenaId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── Blog ────────────────────────────────────────────────────────
    match /blog/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Contactos ───────────────────────────────────────────────────
    match /contactos/{contactoId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Consultas ───────────────────────────────────────────────────
    match /consultas/{consultaId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Solicitudes de residencias (formulario público de alta) ──────
    match /solicitudes/{solicitudId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Solicitudes de profesionales (formulario público de alta) ────
    match /solicitudesProfesionales/{solicitudId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Clicks (seguimiento anónimo de links de contacto) ───────────
    match /clicks/{clickId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Admins ───────────────────────────────────────────────────────
    match /admins/{email} {
      // A user may read only their own admin doc (cannot enumerate admins)
      allow read: if request.auth != null && request.auth.token.email == email;
      // Admins are managed only from the Firebase console / Admin SDK
      allow write: if false;
    }
  }
}
