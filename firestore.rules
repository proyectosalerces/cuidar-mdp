rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Residencias ──────────────────────────────────────────────────
    match /residencias/{residenciaId} {
      // Anyone can read residencias (they are public data)
      allow read: if true;

      // Only admin SDK can write (import script, admin panel)
      allow write: if false;
    }

    // ── Profesionales ────────────────────────────────────────────────
    match /profesionales/{profesionalId} {
      // Anyone can read profesionales (public data)
      allow read: if true;

      // Only admin SDK can write
      allow write: if false;
    }

    // ── Reseñas ──────────────────────────────────────────────────────
    match /resenas/{resenaId} {
      // Anyone can read approved reviews
      allow read: if true;

      // Authenticated users can create reviews
      allow create: if request.auth != null;

      // No one can update or delete via client
      allow update, delete: if false;
    }

    // Block all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
